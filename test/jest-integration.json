{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testRegex": ".*\\.int-spec\\.ts$",
  "testPathIgnorePatterns": [
    "/node_modules/",
    "<rootDir>/test/integration/findings/"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "testTimeout": 120000
}
