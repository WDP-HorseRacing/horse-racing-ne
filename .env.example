NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Postgres (docker/compose.yaml: service "postgres") ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=racehorse
DB_PASSWORD=racehorse
DB_NAME=racehorse

# --- Redis (docker/compose.yaml: service "redis") ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Keycloak (docker/compose.yaml: service "keycloak", cong host 8088) ---
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8088
KEYCLOAK_REALM=racehorse
KEYCLOAK_CLIENT_ID=racehorse-backend
KEYCLOAK_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=''
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/google/callback

# --- Mac dinh cho HTTP goi ra ngoai (tuy chon) ---
AXIOS_TIMEOUT_MS=10000
AXIOS_RETRY_COUNT=3
AXIOS_RETRY_BASE_DELAY_MS=250
AXIOS_RETRY_MAX_DELAY_MS=5000

# --- Google identity provider ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
